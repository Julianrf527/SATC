# Usuario administrador inicial de app-users.
# Copiar a .env.user_admin (no se versiona) y completar.
# app-users lo crea al arrancar solo si la base aún no tiene usuarios.
# Obligatorios: documento, primer nombre, primer apellido, correo y una clave.

ADMIN_NUMERO_DOCUMENTO=
ADMIN_PRIMER_NOMBRE=
ADMIN_SEGUNDO_NOMBRE=
ADMIN_PRIMER_APELLIDO=
ADMIN_SEGUNDO_APELLIDO=
ADMIN_CORREO=

# Una de las dos: la contraseña en texto plano (app-users la hashea) o un hash
# bcrypt ya calculado. Cambiarla en el primer ingreso.
# Usar comillas simples si el valor tiene '$' (p. ej. un hash bcrypt), para que
# docker compose no lo tome como variable: ADMIN_HASH_CONTRASENA='$2b$12$...'
ADMIN_PASSWORD=
ADMIN_HASH_CONTRASENA=
